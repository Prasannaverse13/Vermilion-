# --- Supabase ---
# 1. Create a project at https://supabase.com
# 2. Project Settings -> API -> copy URL + anon public key
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key"

# 3. Project Settings -> API -> copy service_role key (NEVER expose to the client)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key"

# --- Alpaca paper trading ---
# Get keys at https://app.alpaca.markets/account/api-keys
# Make sure to generate a PAPER key with both Trading and Data enabled.
APCA_API_KEY_ID="PKxxxxxxxxxxxxxxxxxxxx"
APCA_API_SECRET_KEY="your-alpaca-secret-key"
APCA_PAPER_BASE_URL="https://paper-api.alpaca.markets"
APCA_DATA_BASE_URL="https://data.alpaca.markets"

# --- DeepSeek reasoning LLM ---
# Get at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY="sk-your-deepseek-key"

# --- Cron (optional) ---
# Shared secret for the scheduled auto-evaluation cycle.
# Leave empty to disable. Generate with: openssl rand -hex 32
CRON_SECRET=""

